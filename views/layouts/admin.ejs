<!DOCTYPE html>
<html
  lang="en"
  class="light-style layout-menu-fixed"
  dir="ltr"
  data-theme="theme-default"
  data-assets-path="../assets/"
  data-template="vertical-menu-template-free"
>
  <head>
    <%- include('../partials/head') %>
  </head>
  <style>
    /* Overlay */
    .page-loader {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;

      display: none; /* hidden by default */

      backdrop-filter: blur(5px); /* 🔥 blur effect */
      background: rgba(0, 0, 0, 0.2); /* slight dark overlay */

      z-index: 9999;

      justify-content: center;
      align-items: center;
    }

    /* Center box */
    .loader-box {
      text-align: center;
      color: #fff;
    }

    /* Spinner */
    .spinner {
      width: 40px;
      height: 40px;
      border: 4px solid #ddd;
      border-top: 4px solid #fff;
      border-radius: 50%;
      margin: auto;
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
      100% {
        transform: rotate(360deg);
      }
    }
  </style>
  <body>
    <!-- Layout wrapper -->
    <div class="layout-wrapper layout-content-navbar">
      <div class="layout-container">
        <!-- Menu -->
        <%- include('../partials/sidebar') %>

        <!-- / Menu -->

        <!-- Layout container -->
        <div class="layout-page">
          <!-- Navbar -->

          <%- include('../partials/navbar')%>

          <!-- / Navbar -->

          <!-- Content wrapper -->
          <div class="content-wrapper">
            <!-- Content -->

            <div class="container-xxl flex-grow-1 container-p-y">
              <%- body %>
            </div>
            <!-- / Content -->

            <!-- Footer -->
            <%- include('../partials/footer') %>
            <!-- / Footer -->
          </div>
          <!-- Content wrapper -->
        </div>
        <!-- / Layout page -->
      </div>
    </div>
    <!-- / Layout wrapper -->
    <%- include('../partials/scripts') %>

    <!--/ Basic Bootstrap Table -->
    <link
      rel="stylesheet"
      href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css"
    />

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script>
      let table;
      $(function () {
        if (!$.fn.DataTable.isDataTable("#usersTable")) {
          table = $("#usersTable").DataTable({
            processing: true,
            serverSide: true,

            ajax: { url: "/admin/api/users", type: "GET" },

            pageLength: 10,

            lengthMenu: [10, 50, 100, 150],

            pagingType: "simple_numbers",

            columns: [
              {
                data: null,
                render: (data, type, row, meta) =>
                  meta.row + meta.settings._iDisplayStart + 1,
              },
              { data: "name" },
              { data: "email" },
              { data: "mobile" },
              {
                data: "status",
                render: function (data) {
                  return data === "Active"
                    ? `<span class="badge bg-success">${data}</span>`
                    : `<span class="badge bg-danger">${data}</span>`;
                },
              },
              {
                data: null,
                render: (data, type, row) => `
                <div class="d-flex gap-2">
                  <button  class="btn btn-sm btn-primary edit-btn" data-id="${row.id}"> Edit </span>
                  <button  class="btn btn-sm btn-danger delete-btn" data-id="${row.id}"> Delete</span>
                </div>
                `,
              },
            ],
          });
        }

        // CUSTOM SEARCH
        $("#usersTable_filter input")
          .off()

          .on("keyup", function () {
            const rawValue = this.value;
            const value = this.value.trim();

            if (rawValue.length > 0 && value.length === 0) {
              return;
            }

            // search only after 3 chars
            if (value.length >= 3 || value.length === 0) {
              table.search(value).draw();
            }
          });
      });

      // Delete User
      $("#usersTable").on("click", ".delete-btn", function () {
        const userid = $(this).data("id");

        swal
          .fire({
            title: "Are you sure?",
            text: "This user will be deleted permanently!",
            icon: "warning",
            showCancelButton: true,
            confirmButtonText: "Yes, delete it!",
            cancelButtonText: "Cancel",
          })
          .then((result) => {
            if (result.isConfirmed) {
              console.log(userid);
              $.ajax({
                url: `/admin/users/${userid}`,
                type: "DELETE",
                dataType: "json",
                success: function (res) {
                  if (res.success == true) {
                    toastr.success("User deleted successfully", "Success");
                  }
                  $("#usersTable").DataTable().ajax.reload(null, false);
                },
              });
            }
          });
      });
      // Delete User

      $("#usersTable").on("click", ".edit-btn", function () {
        const id = $(this).data("id");
        //alert(`Edit id = ${id}`);

        $.ajax({
          url: `/admin/edit-users/${id}`,
          type: "GET",
          contentType: false,
          processData: false,
          dataType: "json",
          success: (res) => {
            console.log("response = ", res);
            $("#username").val(res.data.username);
            $("#email").val(res.data.email);
            $("#mobile").val(res.data.mobile);
            $("#userid").val(res.data.id);
          },
          error: (err) => {
            toastr.error("Something went wrong", "Error");
            $("#pageLoader").hide();
          },
          complete: () => {},
        });

        $("#largeModal").modal("show");
      });

      // $("#usersTable").on("click", ".delete-btn", function () {
      //   const id = $(this).data("id");
      //   alert(`Delete id = ${id}`);
      // });

      toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: "toast-top-right",
        timeOut: 3000,
        extendedTimeOut: 1000,
        preventDuplicates: true,
      };

      $.validator.addMethod(
        "strictEmail",
        function (value, element) {
          const pattern =
            /^[a-zA-Z0-9]+([._%+-][a-zA-Z0-9]+)*@[a-zA-Z0-9-]+(\.[a-zA-Z]{2,})+$/;
          return this.optional(element) || pattern.test(value);
        },
        "Please enter a valid email address",
      );

      $.validator.addMethod(
        "indianMobile",
        function (value, element) {
          const pattern = /^[6-9]\d{9}$/;
          return this.optional(element) || pattern.test(value);
        },
        "Please enter a valid 10-digit Indian mobile number",
      );

      // Update user
      $("#edit_user_form").validate({
        rules: {
          username: {
            required: true,
            minlength: 3,
            maxlength: 100,
          },
          email: {
            required: true,
            strictEmail: true,
          },
          mobile: {
            required: true,
            indianMobile: true,
          },
          avatar: {
            required: false,
            extension: "jpg|jpeg|png",
          },
        },
        messages: {
          username: {
            required: "Username is required",
            minlength: "Username atleast 3 characters",
            maxlength: "Username should not be greater than 100 characters",
          },
          email: {
            required: "Email is required",
          },
          mobile: {
            required: "Mobile is required",
            indianMobile: "Please enter a valid 10-digit Indian mobile number",
          },
          avatar: {
            required: "Avtar is required",
            extension: "Only jpg,jpeg,png allowed",
          },
        },
        errorElement: "small",

        errorClass: "text-danger",

        errorPlacement: function (error, element) {
          if (element.parent(".input-group").length) {
            error.insertAfter(element.parent());
          } else {
            error.insertAfter(element);
          }
        },
        highlight: function (e) {
          $(e).addClass("is-invalid");
        },
        unhighlight: function (e) {
          $(e).removeClass("is-invalid");
        },
        submitHandler: function (form) {
          console.log(`Form submitted`);
          const formData = new FormData(form);

          $("#editBtn").attr("disabled", true);
          $("#pageLoader").css("display", "flex");

          $.ajax({
            url: "/admin/usersUpdate",
            type: "POST",
            data: formData,
            contentType: false,
            processData: false,
            dataType: "json",
            success: (res) => {
              toastr.success("User updated successfully", "Success");
              console.log("response = ", res);
              $("#edit_user_form")[0].reset();
              $("#editBtn").attr("disabled", false);
              $("#pageLoader").hide();
              $("#largeModal").modal("hide");
              $("#usersTable").DataTable().ajax.reload(null, false);
            },
            error: (err) => {
              toastr.error(`Something went wrong ${err}`, "Error");
              $("#pageLoader").hide();
            },
            complete: () => {},
          });
        },
      });

      // Update user

      // Form submission add new user
      $("#add_user_form").validate({
        rules: {
          // username: {
          //   required: true,
          //   minlength: 3,
          //   maxlength: 100,
          // },
          // email: {
          //   required: true,
          //   strictEmail: true,
          // },
          // mobile: {
          //   required: true,
          //   indianMobile: true,
          // },
          avatar: {
            required: false,
            extension: "jpg|jpeg|png",
          },
        },
        messages: {
          // username: {
          //   required: "Username is required",
          //   minlength: "Username atleast 3 characters",
          //   maxlength: "Username should not be greater than 100 characters",
          // },
          email: {
            required: "Email is required",
            strictEmail: "Please enter valid email",
          },
          mobile: {
            required: "Mobile is required",
            indianMobile: "Please enter a valid 10-digit Indian mobile number",
          },
          avatar: {
            required: "Avtar is required",
            extension: "Only jpg,jpeg,png allowed",
          },
        },
        errorElement: "small",

        errorClass: "text-danger",

        errorPlacement: function (error, element) {
          if (element.parent(".input-group").length) {
            error.insertAfter(element.parent());
          } else {
            error.insertAfter(element);
          }
        },
        highlight: function (e) {
          $(e).addClass("is-invalid");
        },
        unhighlight: function (e) {
          $(e).removeClass("is-invalid");
        },
        submitHandler: function (form) {
          console.log(`Form submitted`);
          const formData = new FormData(form);

          $("#saveBtn").attr("disabled", true);
          $("#pageLoader").css("display", "flex");

          $.ajax({
            url: "/admin/users",
            type: "POST",
            data: formData,
            contentType: false,
            processData: false,
            dataType: "json",
            success: (res) => {
              toastr.success("User created successfully", "Success");
              console.log("response = ", res);
              $("#add_user_form")[0].reset();
              $("#saveBtn").attr("disabled", false);
              $("#pageLoader").hide();
            },
            error: (err) => {
              if ((err.status = 422)) {
                $("#saveBtn").attr("disabled", false);
                const errors = err.responseJSON.errors;

                Object.keys(errors).forEach((field) => {
                  const input = $(`[name="${field}"]`);

                  input.addClass("is-invalid");
                  console.log(errors[field]);

                  input.siblings(".invalid-feedback").text(errors[field]);
                });
              }
              toastr.error("Something went wrong", "Error");
              //console.error("Error = ", err.error.username);
              $("#pageLoader").hide();
            },
            complete: () => {},
          });
        },
      });
    </script>

    <div id="pageLoader" class="page-loader">
      <div class="loader-box">
        <div class="spinner"></div>
        <p>Processing...</p>
      </div>
    </div>
  </body>
</html>
